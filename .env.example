SANITY_API_READ_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://www.airtech.com.np

# Lead capture — see docs/OPEN_DECISIONS.md #7.
LEAD_NOTIFICATION_EMAIL=info@airtech.com.np
